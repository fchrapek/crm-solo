APP_NAME="CRM Solo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The documented setup serves https://crm-solo.test (docs/development/setup.md).
# Without that route, use APP_URL=http://127.0.0.1:8101 for a plain-HTTP start
# and open that URL; Vite then serves over http too (vite.config.ts).
APP_URL=https://crm-solo.test
# Hosts the app answers besides APP_URL's, localhost, 127.0.0.1 and [::1].
# Comma-separated, no scheme or port. Any other Host gets a 400.
APP_ALLOWED_HOSTS=
# Proxies whose X-Forwarded-* headers are believed. Loopback covers the local
# traefik and nginx routes; a deployment names its own proxy here.
TRUSTED_PROXIES=127.0.0.1,::1
# Behind Cloudflare only: read the visitor IP from CF-Connecting-IP when the
# peer is a trusted proxy and the hop before it is a Cloudflare address
# (CLOUDFLARE_IP_RANGES overrides the shipped list).
TRUST_CF_CONNECTING_IP=false
APP_DISPLAY_TIMEZONE=UTC

LOCALIZATION_ALIGN=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
# Host and port as seen from the machine running PHP. `composer run dev`
# runs PHP on the host, so these are docker-compose's published ports, not
# the container-internal ones.
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=crm_solo
DB_USERNAME=crm_solo
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset, the session cookie is Secure exactly when APP_URL is https.
# SESSION_SECURE_COOKIE=

# Password for the owner `php artisan migrate --seed` creates. Leave empty and
# the seeder generates one and prints it once.
SEED_OWNER_PASSWORD=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Use "sync" for local dev (no Horizon needed). Set to "redis" in production with Horizon running.
QUEUE_CONNECTION=sync

CACHE_STORE=redis

# predis is a composer dependency, so this works with no PHP extension.
# Switch to phpredis only if you have installed that extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63790

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Mailpit: SMTP on 10250, web UI on http://localhost:18025
MAIL_HOST=127.0.0.1
MAIL_PORT=10250
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=1001
# Blank on purpose: `php artisan setup:reverb-keys` fills both with random
# values (composer run setup does it for you).
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Reverb listens on loopback only. Set 0.0.0.0 only where another machine or
# container must reach it.
REVERB_SERVER_HOST=127.0.0.1
REVERB_HOST=localhost
# 8081 rather than Reverb's default 8080, which a local DDEV router often
# already holds.
REVERB_PORT=8081
REVERB_SERVER_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"



TRELLO_API_KEY=
TRELLO_API_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_DEFAULT_PROVIDER=openai

# Lead pull from WordPress multisite sites (kiwwwi:sync-leads). Needs a WP
# Application Password for a dedicated read-only user, and the companion
# mu-plugin that exposes the submissions endpoint on each site. Leave blank to
# disable the scheduled pull; a blank site URL leaves only that site out.
KIWWWI_LEADS_BASE_URL=
KIWWWI_LEADS_EN_BASE_URL=
KIWWWI_LEADS_USERNAME=
KIWWWI_LEADS_APP_PASSWORD=
# ConsentLite banner revision a consent cookie must carry (widget default 0)
KIWWWI_CONSENT_REVISION=0

# Browser-facing host for terminal-session / task-preview iframes. Change only
# when the browser and the CRM server are different machines (LAN/VPS).
TERMINAL_SESSION_HOST=localhost
# Lets the app run processes on this machine (terminal sessions, previews,
# repository git calls, the daily-session viewport). Always off in DEMO_MODE.
CRM_HOST_EXEC=true

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Closed mode: guests see the /czesc splash, signups become leads in this
# account (config/waitlist.php). Off locally and on the demo.
APP_CLOSED=false
WAITLIST_ACCOUNT_ID=
WAITLIST_PIPELINE=
WAITLIST_PER_MINUTE=5
WAITLIST_PER_HOUR=20
