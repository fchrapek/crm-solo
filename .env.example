APP_NAME="CRM Solo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://crm-solo.test
APP_DISPLAY_TIMEZONE=UTC

LOCALIZATION_ALIGN=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
# Host and port as seen from the machine running PHP. `composer run dev`
# runs PHP on the host, so these are docker-compose's published ports, not
# the container-internal ones.
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=crm_solo
DB_USERNAME=crm_solo
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Use "sync" for local dev (no Horizon needed). Set to "redis" in production with Horizon running.
QUEUE_CONNECTION=sync

CACHE_STORE=redis

# predis is a composer dependency, so this works with no PHP extension.
# Switch to phpredis only if you have installed that extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63790

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Mailpit: SMTP on 10250, web UI on http://localhost:18025
MAIL_HOST=127.0.0.1
MAIL_PORT=10250
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=1001
REVERB_APP_KEY=laravel-reverb-key
REVERB_APP_SECRET=secret
REVERB_HOST=localhost
# 8081 rather than Reverb's default 8080, which a local DDEV router often
# already holds.
REVERB_PORT=8081
REVERB_SERVER_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"



TRELLO_API_KEY=
TRELLO_API_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_DEFAULT_PROVIDER=openai

# Lead pull from a WordPress site (kiwwwi:sync-leads). Needs a WP Application
# Password for a dedicated read-only user, and the companion mu-plugin that
# exposes the submissions endpoint. Leave blank to disable the scheduled pull.
KIWWWI_LEADS_BASE_URL=
KIWWWI_LEADS_USERNAME=
KIWWWI_LEADS_APP_PASSWORD=

# Browser-facing host for terminal-session / task-preview iframes. Change only
# when the browser and the CRM server are different machines (LAN/VPS).
TERMINAL_SESSION_HOST=localhost

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
