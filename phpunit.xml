<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Request scheme follows APP_URL, and an https .env (the shipped
             example) turns on HSTS that tests assert is absent. -->
        <env name="APP_URL" value="http://localhost"/>
        <!-- Pinned: tests assert on English copy, so a Polish .env must not
             fail them. -->
        <env name="APP_LOCALE" value="en"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="APP_DISPLAY_TIMEZONE" value="UTC"/>
        <!-- The file driver writes storage/framework/down, which every
             parallel process (and a dev server on this checkout) reads. -->
        <env name="APP_MAINTENANCE_DRIVER" value="cache"/>
        <env name="APP_MAINTENANCE_STORE" value="array"/>
        <env name="AGENT_DEFAULT_EXECUTOR" value="claude_code"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Never inherit the dev machine's Turnstile gate: tests post
             /login without tokens and configure the secret per-test. -->
        <env name="TURNSTILE_SECRET" value=""/>
        <!-- Same for closed mode: tests expect guests sent to /login. -->
        <env name="APP_CLOSED" value="false"/>
        <!-- Pinned in both $_SERVER (which Laravel reads first and the shell
             fills) and the forced env, so a shell-exported DB_* cannot win.
             DB_URL is emptied because its parsed driver and database
             override the other pins. APP_CONFIG_CACHE points at a file that
             never exists: a cached config would skip every pin here. -->
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/config.phpunit.php"/>
        <server name="DB_URL" value=""/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.phpunit.php" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- The whole suite runs in one process and already peaked within a
             few MB of PHP's 128M default. -->
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
