# Template for the public demo instance (demo.crm-solo.com).
# Copy to the deploy directory as .env on the server and fill the blanks.
# Pairs with compose.demo.yaml — slim stack: sync queue, no Reverb, no SSR.

# Container image the workflow pushed, without the :demo tag.
DEMO_IMAGE=          # e.g. ghcr.io/<owner>/<repo>

APP_NAME="CRM Solo"
APP_ENV=production
APP_KEY=                # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://demo.crm-solo.com
APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_DISPLAY_TIMEZONE=Europe/Warsaw

# Demo mode: allows demo:reset (nightly wipe + reseed of fictional data) and
# shows/prefills the demo credentials on the login page.
DEMO_MODE=true
DEMO_PASSWORD=          # the password visitors log in with; keep it typeable

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=crm_solo_demo
DB_USERNAME=crm_solo_demo
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis

# No Horizon on the demo — nothing long-running to queue.
QUEUE_CONNECTION=sync

# No outbound mail from the demo, ever.
MAIL_MAILER=log

INERTIA_SSR_ENABLED=false

# Intentionally absent: OPENAI_*, INFAKT_*, TRELLO_*, CLOCKIFY_*, KIWWWI_*
# and any OAuth keys. Report generation falls back to the deterministic
# composer by design; integrations stay unconfigured.

# Bot protection on the login form. Set the secret from the Cloudflare
# Turnstile widget to activate the gate; unset = no widget, no enforcement.
TURNSTILE_SECRET=
